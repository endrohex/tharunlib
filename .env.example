# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/library?retryWrites=true&w=majority

# Firebase Server-side Admin (for Vercel production)
FIREBASE_PROJECT_ID=library-6fe26
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@library-6fe26.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Deployment URL (Used for QR code URLs)
PUBLIC_BASE_URL=https://your-library-app.vercel.app

# Local dev port
PORT=3000
